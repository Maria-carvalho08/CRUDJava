<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
   <children>
      <Pane prefHeight="400.0" prefWidth="603.0" style="-fx-background-color: #8B0000; -fx-text-fill: #FFFFFF;">
         <children>
            <Label layoutX="155.0" layoutY="-12.0" text="Cadastrar Alunos">
               <font>
                  <Font name="System Bold Italic" size="36.0" />
               </font>
            </Label>
            <HBox layoutX="131.0" layoutY="356.0" prefHeight="38.0" prefWidth="341.0" spacing="10.0">
               <children>
                  <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#btnSalvarAction" style="-fx-background-color: black;" text="Cadastrar" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#btnLimparAction" style="-fx-background-color: black;" text="Limpar" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnDeletar" mnemonicParsing="false" onAction="#btnDeletarAction" style="-fx-background-color: black;" text="Deletar" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#btnAtualizarAction" style="-fx-background-color: black;" text="Atualizar" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="tblAlunos" layoutX="111.0" layoutY="148.0" onMouseClicked="#selecionarAluno" prefHeight="200.0" prefWidth="381.0" style="-fx-background-color: #969696;">
               <columns>
                  <TableColumn fx:id="colID" prefWidth="75.0" text="ID" />
                  <TableColumn fx:id="colNome" prefWidth="75.0" text="Nome" />
                  <TableColumn fx:id="colIdade" prefWidth="75.0" text="Idade" />
                  <TableColumn fx:id="colCurso" prefWidth="75.0" text="Curso" />
                  <TableColumn fx:id="colNotaFinal" prefWidth="75.0" text="Nota Final" />
               </columns>
            </TableView>
            <TextField fx:id="txtID" layoutX="140.0" layoutY="41.0" />
            <TextField fx:id="txtNome" layoutX="140.0" layoutY="74.0" />
            <Label layoutX="105.0" layoutY="45.0" text="ID" />
            <Label layoutX="95.0" layoutY="78.0" text="Nome" />
            <TextField fx:id="txtIdade" layoutX="383.0" layoutY="41.0" />
            <TextField fx:id="txtCurso" layoutX="383.0" layoutY="74.0" />
            <TextField fx:id="txtNotaFinal" layoutX="383.0" layoutY="105.0" />
            <Label layoutX="320.0" layoutY="45.0" text="Idade" />
            <Label layoutX="321.0" layoutY="78.0" text="Curso" />
            <Label layoutX="322.0" layoutY="109.0" text="Nota Final" />
         </children>
      </Pane>
   </children>
</AnchorPane>
